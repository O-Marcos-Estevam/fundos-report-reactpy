{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "git lfs install && git lfs pull"
  },
  "deploy": {
    "startCommand": "python src/app/main.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "env": {
      "LOAD_SAMPLE_DATA": "false",
      "USE_MOCK_DATA": "false",
      "PYTHONUNBUFFERED": "1"
    }
  }
}