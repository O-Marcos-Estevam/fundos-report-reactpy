# Configurações de Ambiente - Relatório Diário de Fundos
# Copie este arquivo para .env e ajuste as variáveis

# Aplicação
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=False

# Banco de Dados MS Access
DB_PATH=C:\bloko\Fundos - Documentos\00. Monitoramento\01. Rotinas\03. Arquivos Rotina\09. Base_de_Dados\Base Fundos_V2.accdb

# Módulos de Relatório
CAMINHO_MODULO=C:\bloko\Fundos - Documentos\00. Monitoramento\01. Rotinas\0. Python

# Versão padrão do módulo (v4, v5, v6)
DEFAULT_MODULE_VERSION=v6

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# Performance
PARALLEL_QUERIES=true
MAX_WORKERS=3
